#!/usr/bin/env python3
"""Send limited, explicit USB HID reports through the Orange Pi gadget."""
from __future__ import annotations

import argparse
import time
from pathlib import Path

KEYS = {chr(ord("a") + index): 0x04 + index for index in range(26)}
KEYS.update(
    {
        "1": 0x1E, "2": 0x1F, "3": 0x20, "4": 0x21, "5": 0x22,
        "6": 0x23, "7": 0x24, "8": 0x25, "9": 0x26, "0": 0x27,
        "enter": 0x28, "escape": 0x29, "backspace": 0x2A, "tab": 0x2B,
        "space": 0x2C, "minus": 0x2D, "equals": 0x2E, "left_bracket": 0x2F,
        "right_bracket": 0x30, "backslash": 0x31, "semicolon": 0x33,
        "apostrophe": 0x34, "grave": 0x35, "comma": 0x36, "period": 0x37,
        "slash": 0x38, "caps_lock": 0x39, "right": 0x4F, "left": 0x50,
        "down": 0x51, "up": 0x52, "non_us_backslash": 0x64,
    }
)
MODIFIERS = {"ctrl": 0x01, "shift": 0x02, "alt": 0x04, "cmd": 0x08}


def keyboard(key: str) -> None:
    report_key(0, key)


def report_key(modifier: int, key: str) -> None:
    usage = KEYS[key.lower()]
    endpoint = Path("/dev/hidg0")
    with endpoint.open("wb", buffering=0) as report:
        report.write(bytes((modifier, 0, usage, 0, 0, 0, 0, 0)))
        time.sleep(0.12)
        report.write(bytes(8))


def combo(modifier: str, key: str) -> None:
    report_key(MODIFIERS[modifier], key)


def switch_app(count: int) -> None:
    endpoint = Path("/dev/hidg0")
    with endpoint.open("wb", buffering=0) as report:
        for _ in range(count):
            report.write(bytes((MODIFIERS["cmd"], 0, KEYS["tab"], 0, 0, 0, 0, 0)))
            time.sleep(0.12)
            report.write(bytes((MODIFIERS["cmd"], 0, 0, 0, 0, 0, 0, 0)))
            time.sleep(0.12)
        report.write(bytes(8))


def mouse(dx: int, dy: int, wheel: int) -> None:
    if not all(-127 <= value <= 127 for value in (dx, dy, wheel)):
        raise ValueError("mouse values must be between -127 and 127")
    with Path("/dev/hidg1").open("wb", buffering=0) as endpoint:
        endpoint.write(bytes((0, dx & 0xFF, dy & 0xFF, wheel & 0xFF)))


def click() -> None:
    with Path("/dev/hidg1").open("wb", buffering=0) as endpoint:
        endpoint.write(bytes((1, 0, 0, 0)))
        time.sleep(0.08)
        endpoint.write(bytes(4))


parser = argparse.ArgumentParser()
subcommands = parser.add_subparsers(dest="command", required=True)
key_parser = subcommands.add_parser("key")
key_parser.add_argument("key", choices=sorted(KEYS))
mouse_parser = subcommands.add_parser("mouse")
mouse_parser.add_argument("dx", type=int)
mouse_parser.add_argument("dy", type=int)
mouse_parser.add_argument("wheel", type=int, nargs="?", default=0)
subcommands.add_parser("click")
combo_parser = subcommands.add_parser("combo")
combo_parser.add_argument("modifier", choices=sorted(MODIFIERS))
combo_parser.add_argument("key", choices=sorted(KEYS))
switch_parser = subcommands.add_parser("switch")
switch_parser.add_argument("count", type=int, choices=range(1, 16))
arguments = parser.parse_args()

if arguments.command == "key":
    keyboard(arguments.key)
elif arguments.command == "click":
    click()
elif arguments.command == "combo":
    combo(arguments.modifier, arguments.key)
elif arguments.command == "switch":
    switch_app(arguments.count)
else:
    mouse(arguments.dx, arguments.dy, arguments.wheel)
